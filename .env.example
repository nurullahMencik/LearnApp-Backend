# Kopyalayıp .env olarak kaydedin; değerleri kendiniz doldurun.
PORT=5000
# MongoDB Atlas: Database > Connect > Drivers bağlantı adresi (sonuna veritabanı adı)
MONGO_URI=mongodb+srv://<kullanici>:<parola>@<cluster>.mongodb.net/egitim-platformu?retryWrites=true&w=majority
JWT_SECRET=<uzun-rastgele-bir-deger>
# Yol haritası (Gemini) için Google AI Studio anahtarı
GOOGLE_API_KEY=<anahtar>
